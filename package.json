{
  "name": "amalink",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @amalink/web",
    "dev:api": "npm run start:dev --workspace @amalink/api",
    "build": "npm run build --workspace @amalink/types && npm run build --workspace @amalink/api && npm run build --workspace @amalink/web",
    "test:api": "npm run test --workspace @amalink/api"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
